!* variableSubst true
!* commandSubst true
$header

! set i 0
! foreach case $cases {
!   set test_id "${slug}-[incr i]"
!   if {$i > 1} {
skip $test_id
!   }
test $test_id [testTitle $case] \
    -body {twoBucket [asList [dict get $case input]]} \
!   if {[dict exists $case expected error]} {
    -returnCodes error \
    -match glob \
    -result "*impossible*"
!   } else {
    -returnCodes ok \
    -match dictionary \
    -result [asList [dict get $case expected]]
!   }

! }

$footer
