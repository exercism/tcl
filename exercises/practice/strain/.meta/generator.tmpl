!* variableSubst true
!* commandSubst true
$header

! array set predicates {
!   {fn(x) -> true} {{expr {true}}}
!   {fn(x) -> false} {{expr {false}}}
!   {fn(x) -> x % 2 == 1} {{expr {$x % 2 == 1}}}
!   {fn(x) -> x % 2 == 0} {{expr {$x % 2 == 0}}}
!   {fn(x) -> starts_with(x, 'z')} {{string match {z*} $x}}
!   {fn(x) -> contains(x, 5)} {{expr {5 in $x}}}
! }
! set i 0
! foreach case $cases {
!   set test_id "${slug}-[incr i]"
!   if {$i > 1} {
skip $test_id
!   }
test $test_id [testTitle $case] -body {
!   set input [dict get $case input list]
!   if {[llength $input] > 0 && [llength [lindex $input 0]] > 1} {
    set rows [asList $input -lists y -multiline y -indent 2]
!   set args [format {x $rows %s} $predicates([dict get $case input predicate])]
    [dict get $case property] $args
} -returnCodes ok -match listOfLists -result [asList [dict get $case expected] -lists y -multiline y -indent 1]

!   } else {
    [dict get $case property] x [asList $input] $predicates([dict get $case input predicate])
} -returnCodes ok -result [asList [dict get $case expected]]

!   }
! }

$footer
